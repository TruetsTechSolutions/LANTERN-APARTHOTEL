# =======================================================
# Turm Hotel PMS - Odoo & Integration Configuration
# =======================================================

# Set to "true" to use rich realistic simulated data for development
# Set to "false" to connect live to Odoo 19 (Odoo.sh or VPS)
ODOO_MOCK_MODE=true

# Odoo Backend Instance Details (Odoo.sh or VPS)
ODOO_URL=https://your-hotel-instance.odoo.sh
ODOO_DB=your_database_name
ODOO_USERNAME=admin@turmhotel.com
ODOO_API_KEY=your_odoo_api_key_or_password

# Hotel Configuration
NEXT_PUBLIC_HOTEL_NAME="Turm Grand Hotel & Spa"
NEXT_PUBLIC_HOTEL_CURRENCY="EUR"
NEXT_PUBLIC_HOTEL_CURRENCY_SYMBOL="€"

# OTA Channel Management (Channex / Beds24 webhook secret)
OTA_WEBHOOK_SECRET=channex_secure_webhook_token_xyz
